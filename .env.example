# ---------- Infra (docker compose) ----------
POSTGRES_USER=prospecter
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Chave global da Evolution API (usada pelo Prospecter para chamar a API).
# Gere uma aleatória, ex.: node -e "console.log(crypto.randomUUID())"
EVOLUTION_API_KEY=troque-esta-chave


# ---------- Prospecter ----------
PORT=3000
TZ=America/Sao_Paulo

# Quando o app roda no host (npm run dev). Dentro do compose esses valores são sobrescritos.
DATABASE_URL=postgres://prospecter:troque-esta-senha@localhost:5432/prospecter
EVOLUTION_URL=http://localhost:8080
# URL que a Evolution (dentro do Docker) usa para chamar o webhook do Prospecter.
WEBHOOK_URL=http://host.docker.internal:3000/webhook/evolution

# Segredo enviado pela Evolution no header x-prospecter-token do webhook.
WEBHOOK_TOKEN=troque-este-token

# Senha do painel (Basic Auth, usuário "admin"). Vazio = painel sem senha.
PANEL_PASSWORD=

# Palavras que fazem o contato sair da lista (separadas por vírgula).
OPT_OUT_KEYWORDS=sair,parar,pare,stop,cancelar,descadastrar,remover
# Resposta automática quando alguém pede para sair. Vazio = não responde.
OPT_OUT_REPLY="Tudo bem! Você não receberá mais mensagens nossas."

# ---------- WatchTower (MCP) ----------
# URL do servidor MCP do WatchTower (Streamable HTTP). Vazio = integração desligada.
WATCHTOWER_MCP_URL=
# Opcional: token Bearer fixo. Sem ele, conecte pela aba WatchTower do painel (OAuth).
WATCHTOWER_MCP_TOKEN=
# Endereço do painel no navegador; o OAuth volta para PUBLIC_URL/integrations/watchtower/callback.
PUBLIC_URL=http://localhost:3000
