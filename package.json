{
  "name": "prospecter",
  "version": "0.1.0",
  "private": true,
  "description": "Disparador automático de mensagens de prospecção via WhatsApp (Evolution API)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d postgres redis evolution",
    "up": "docker compose up -d --build",
    "down": "docker compose down"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.7",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
